          "shop": {
            "type": "string",
            "required": true
          }
        }
      }
    },
    "setup": {
      "label": "Shopify",
      "category": "Commerce",
      "key": "Admin API access token",
      "keyHint": "From a custom app in your store admin. Starts with shpat_. Every call also sends \"shop\": your store name before .myshopify.com.",
      "keyUrl": "https://help.shopify.com/en/manual/apps/app-types/custom-apps",
      "example": {
        "action": "order.create",
        "payload": {
          "shop": "your-store",
          "order": {
            "line_items": [
              {
                "title": "Test",
                "price": "5.00",
                "quantity": 1
              }
            ]
          }
        }
      }
    }
  },
