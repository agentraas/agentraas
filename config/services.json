{
  "stripe": {
    "baseUrl": "https://api.stripe.com/v1",
    "authHeader": "Authorization",
    "contentType": "application/x-www-form-urlencoded",
    "actions": {
      "charge.create": {
        "method": "POST",
        "path": "/charges",
        "validation": {
          "amount": {
            "type": "number",
            "min": 1
          },
          "currency": {
            "type": "string",
            "required": true
          },
          "customer": {
            "type": "string",
            "required": true
          }
        },
        "undo": {
          "action": "charge.refund",
          "with": {
            "charge": "response.id"
          }
        }
      },
      "customer.create": {
        "method": "POST",
        "path": "/customers",
        "validation": {
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "charge.refund": {
        "method": "POST",
        "path": "/refunds",
        "validation": {
          "charge": {
            "type": "string",
            "required": true
          }
        }
      },
      "payment_intent.create": {
        "method": "POST",
        "path": "/payment_intents",
        "validation": {
          "amount": {
            "type": "number",
            "required": true,
            "min": 1
          },
          "currency": {
            "type": "string",
            "required": true
          }
        }
      },
      "payment_intent.refund": {
        "method": "POST",
        "path": "/refunds",
        "validation": {
          "payment_intent": {
            "type": "string",
            "required": true
          }
        }
      },
      "subscription.create": {
        "method": "POST",
        "path": "/subscriptions",
        "validation": {
          "customer": {
            "type": "string",
            "required": true
          },
          "items": {
            "type": "array",
            "required": true
          }
        },
        "undo": {
          "action": "subscription.cancel",
          "with": {
            "id": "response.id"
          }
        }
      },
      "subscription.cancel": {
        "method": "DELETE",
        "path": "/subscriptions/{id}",
        "validation": {
          "id": {
            "type": "string",
            "required": true
          }
        }
      },
      "invoice.create": {
        "method": "POST",
        "path": "/invoices",
        "validation": {
          "customer": {
            "type": "string",
            "required": true
          }
        }
      }
    },
    "setup": {
      "label": "Stripe",
      "category": "Payments",
      "key": "Secret key",
      "keyHint": "Starts with sk_test_ or sk_live_. Try a test key first.",
      "keyUrl": "https://dashboard.stripe.com/apikeys",
      "example": {
        "action": "payment_intent.create",
        "payload": {
          "amount": 500,
          "currency": "usd"
        }
      }
    }
  },
