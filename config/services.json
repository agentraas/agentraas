      "key": "Internal integration secret",
      "keyHint": "Starts with ntn_. Share the page or database with the integration.",
      "keyUrl": "https://www.notion.so/profile/integrations",
      "example": {
        "action": "page.create",
        "payload": {
          "parent": {
            "database_id": "your-database-id"
          },
          "properties": {
            "Name": {
              "title": [
                {
                  "text": {
                    "content": "New task"
                  }
                }
              ]
            }
          }
        }
      }
    },
    "actions": {
      "page.create": {
        "method": "POST",
        "path": "/pages",
        "validation": {
          "parent": {
            "type": "object",
            "required": true
          },
          "properties": {
            "type": "object",
            "required": true
          }
        }
      }
    }
  },
  "zendesk": {
    "baseUrl": "https://{subdomain}.zendesk.com/api/v2",
    "authType": "basic",
    "contentType": "application/json",
    "setup": {
      "label": "Zendesk",
      "category": "Support",
      "username": "Email followed by /token",
      "usernameHint": "For example you@company.com/token",
      "password": "API token",
      "keyUrl": "https://support.zendesk.com/hc/en-us/articles/4408889192858",
      "example": {
        "action": "ticket.create",
        "payload": {
          "subdomain": "yourcompany",
          "ticket": {
            "subject": "Refund request",
            "comment": {
              "body": "Customer asked for a refund."
            }
          }
        }
      }
    },
    "actions": {
      "ticket.create": {
        "method": "POST",
        "path": "/tickets.json",
        "validation": {
          "subdomain": {
            "type": "string",
            "required": true
          },
          "ticket": {
            "type": "object",
            "required": true
          }
        }
      }
    }
  },
  "jira": {
    "baseUrl": "https://{site}.atlassian.net/rest/api/2",
    "authType": "basic",
    "contentType": "application/json",
    "setup": {
      "label": "Jira",
      "category": "Support",
      "username": "Atlassian account email",
      "usernameHint": "The email you log in to Jira with",
      "password": "API token",
      "keyUrl": "https://id.atlassian.com/manage-profile/security/api-tokens",
      "example": {
        "action": "issue.create",
        "payload": {
          "site": "yourcompany",
          "fields": {
            "project": {
              "key": "OPS"
            },
            "issuetype": {
              "name": "Task"
            },
            "summary": "Refund failed for order 1042",
            "description": "The agent's refund call returned a card_declined error."
          }
        }
      }
    },
    "actions": {
      "issue.create": {
        "method": "POST",
        "path": "/issue",
        "validation": {
          "site": {
            "type": "string",
            "required": true
          },
          "fields": {
            "type": "object",
            "required": true
          }
        },
        "undo": {
          "action": "issue.delete",
          "with": {
            "site": "payload.site",
            "issueKey": "response.key"
          }
        }
      },
      "issue.comment": {
        "method": "POST",
        "path": "/issue/{issueKey}/comment",
        "validation": {
          "site": {
            "type": "string",
            "required": true
          },
          "issueKey": {
            "type": "string",
            "required": true
          },
          "body": {
            "type": "string",
            "required": true
          }
        }
      },
      "issue.transition": {
        "method": "POST",
        "path": "/issue/{issueKey}/transitions",
        "validation": {
          "site": {
            "type": "string",
            "required": true
          },
          "issueKey": {
            "type": "string",
            "required": true
          },
          "transition": {
            "type": "object",
            "required": true
          }
        }
      },
      "issue.delete": {
        "method": "DELETE",
        "path": "/issue/{issueKey}",
        "validation": {
          "site": {
            "type": "string",
            "required": true
          },
          "issueKey": {
            "type": "string",
            "required": true
          }
        }
      }
    }
  }
